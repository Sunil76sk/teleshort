# ==============================================================================
# TELESHORT v2.1 — ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase PostgreSQL Configuration (Backend Service Role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Telegram Bot Credentials
# Never commit a real bot token to GitHub.
BOT_TOKEN=your-telegram-bot-token
BOT_USERNAME=myfileshareskbot
TELEGRAM_BOT_ID=your-telegram-bot-id
MINI_APP_URL=https://your-production-domain.example

# Security & Secrets
ADMIN_SESSION_SECRET=replace-with-a-random-secret
CHALLENGE_SECRET=replace-with-a-random-secret

# Monetag Configuration
MONETAG_ZONE_ID=11694314
MONETAG_SHOW_FUNCTION=show_11694314

# Platform Configuration Defaults
DEFAULT_CPM=2.00
DEFAULT_MIN_WITHDRAWAL=5.00
DEFAULT_REFERRAL_PERCENT=10
