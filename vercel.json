{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**/*.js"
    }
  },
  "redirects": [
    { "source": "/admin", "destination": "/admin.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!admin(?:\\.html)?$).*)", "destination": "/index.html" }
  ]
}
